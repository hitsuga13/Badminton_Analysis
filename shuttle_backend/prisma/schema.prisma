generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  hand      String
  age       Int
  heightCm  Int
  weightKg  Int
  rank      Int
  form      Int[]
}

model Match {
  id          Int      @id @default(autoincrement())
  player1Id   Int
  player2Id   Int
  player1Score Int
  player2Score Int
  date        DateTime
}
